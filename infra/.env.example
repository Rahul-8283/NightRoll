# Settings for docker-compose.yml itself. Copy to infra/.env and fill in. This file is read by Compose,
# not by the services; each service keeps its own env file (backend/.env, face/.env).

# demo, pilot or production. The API refuses to start in pilot or production with unsafe settings.
APP_ENV=demo

# The name or LAN address phones and the warden's laptop use to reach this server. It must be in the
# certificate in infra/certs (see infra/certs/README.md).
SERVER_NAME=nightroll.local

# The Supabase project URL and its public anon key. Both end up in the dashboard bundle, so never put
# the service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
