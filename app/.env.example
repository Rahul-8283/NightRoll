# Expo bakes EXPO_PUBLIC_ values into the app at build time. Never put secrets here.
# Android emulator reaches the host at 10.0.2.2. A real phone needs the laptop's LAN address,
# for example http://192.168.1.20:8000/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/v1
EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=
# Set to true to view Expo Go screens with mock data, without the backend
EXPO_PUBLIC_MOCK_STATUS=false
