# Local development talks to the API directly. Behind the reverse proxy (Phase 12) use the paths /v1 and /v1/ws/rooms.
VITE_API_BASE_URL=http://localhost:8000/v1
VITE_WS_URL=ws://localhost:8000/v1/ws/rooms
# Public anon key only. The service role key never goes here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
