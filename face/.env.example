BLUR_THRESHOLD=60.0
LIGHT_MIN=35.0
LIGHT_MAX=230.0
MAX_POSE_YAW=30.0
MAX_POSE_PITCH=25.0
MAX_POSE_ROLL=25.0
ENROLL_MIN_AGREEMENT=0.55
ENROLL_MIN_VALID_FRAMES=3
