# Runtime
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata

# Supabase (server side only; never put the service role key in the app or dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
REQUIRE_MFA=true

# Redis (Upstash, hosted, TLS). Format: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=

# Face worker
FACE_WORKER_URL=http://localhost:8100
FACE_WORKER_TOKEN=

# Google service account (Play Integrity decode)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# Play Integrity
PLAY_INTEGRITY_PACKAGE_NAME=com.zerolatency.nightroll
PLAY_INTEGRITY_ENFORCE=false

# Attendance window defaults
WINDOW_DEFAULT_OPEN=22:00
WINDOW_DEFAULT_CLOSE=22:30

# Network gate: subnet | controller | radius | off
NETWORK_VERIFY_MODE=subnet
TRUSTED_PROXY_IPS=127.0.0.1

# Trust score (provisional, tuned in Phase 13)
WEIGHT_FACE=0.30
WEIGHT_FINGERPRINT=0.30
WEIGHT_LIVENESS=0.20
WEIGHT_OWN_AP=0.15
WEIGHT_AP_AGREEMENT=0.05
THRESHOLD_PRESENT=0.80
THRESHOLD_REVIEW=0.60

# Scorer thresholds (Phase 9). Provisional until the walk test and Phase 13 tuning.
FACE_SIM_LOW=0.45
FACE_SIM_HIGH=0.50
ANTISPOOF_MIN=0.90
HEAD_TURN_MIN_DEG=15
HEAD_TURN_LEFT_SIGN=-1
OWN_AP_RSSI_LOW=-75
OWN_AP_RSSI_HIGH=-55
FP_NEIGHBOUR_LOW=0.3
FP_NEIGHBOUR_HIGH=0.7
FP_UNKNOWN_FREE=2
FP_UNKNOWN_STEP=0.1
FP_UNKNOWN_CAP=0.5
SCAN_STALE_MS=30000
AP_AGREEMENT_FULL_DB=10
AP_AGREEMENT_ZERO_DB=25
FACE_WORKER_TIMEOUT_SECONDS=5
